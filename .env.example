# ═══════════════════════════════════════════════════════════════
# ERPQu Development Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env:  cp .env.example .env
# For production, use .env.production.example instead.
# ═══════════════════════════════════════════════════════════════

# Environment mode: development | staging | production
ENVIRONMENT=development

# ─── Database Configuration ────────────────────────────────
# PostgreSQL superuser (used for migrations)
DB_USER=postgres
DB_PASSWORD=postgres

# Application database user (restricted privileges, used by backend)
DB_APP_USER=erpqu_app
DB_APP_PASSWORD=erpqu_app_dev_only

# Database name
DB_NAME=management_system

# Host port mapping (5436 to avoid conflict with local PostgreSQL)
DB_PORT=5436

# Full connection URLs with multi-schema search_path
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5436/management_system?options=-c%20search_path=public,hr,crm,rental,inventory,commercial
DATABASE_URL=postgres://erpqu_app:erpqu_app_dev_only@localhost:5436/management_system?options=-c%20search_path=public,hr,crm,rental,inventory,commercial

# Test app DB role (used in integration tests)
TEST_APP_DB_ROLE=erpqu_app

# ─── Redis Cache ────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── API Server ─────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8181

# ─── JWT Authentication ────────────────────────────────────
# DEV ONLY — change to a strong 32+ char secret in production
JWT_SECRET=change-this-jwt-secret-in-production-min-32-chars
JWT_EXPIRATION_HOURS=24

# ─── Security Policies ─────────────────────────────────────
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_DEV_TEST_ROUTES=false

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated allowed origins (leave empty for permissive dev mode)
CORS_ALLOWED_ORIGINS=

# ─── File Upload ────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10

# ─── SMTP Email (Optional) ─────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# ─── Logging ────────────────────────────────────────────────
# human = pretty console output, json = structured for log aggregation
RUST_LOG=management_system=info,tower_http=info
LOG_FORMAT=human
