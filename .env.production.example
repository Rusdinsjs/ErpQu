# ==============================================================================
# ERPQu Production Environment Configuration Template
# ==============================================================================
# Petunjuk Penggunaan:
# 1. Salin file ini menjadi .env pada root proyek di server produksi:
#    cp .env.production.example .env
# 2. Amankan permission file .env agar hanya bisa dibaca pemilik:
#    chmod 600 .env
# 3. Ganti seluruh nilai rahasia (password, secret key, token) dengan nilai aman.
# ==============================================================================

# --- DOMAIN & REVERSE PROXY (NGINX / SSL) ---
# Nama domain yang diarahkan (DNS A Record) ke IP Publik server Anda
NGINX_HOST=erp.perusahaan.co.id

# --- POSTGRESQL DATABASE CONFIGURATION ---
# Superuser postgres (digunakan untuk inisialisasi & migrasi skema database)
DB_USER=postgres
DB_PASSWORD=GantiDenganPasswordDatabaseSuperuserYangKuat123!
DB_NAME=management_system

# Restricted Application User (pengguna database dengan hak terbatas untuk API)
DB_APP_USER=erpqu_app
DB_APP_PASSWORD=GantiDenganPasswordDatabaseAppUserYangKuat123!

# --- REDIS IN-MEMORY CACHE & SESSION STORE ---
REDIS_PASSWORD=GantiDenganPasswordRedisKuatDanAcak32Karakter!

# --- SECURITY & AUTHENTICATION (JWT) ---
# Kunci enkripsi token login (Wajib minimal 32 karakter acak!)
# Generate via: openssl rand -base64 32
JWT_SECRET=U29tZVNlY3VyZVJhbmRvbVN0cmluZ0Zvckp3dFNlY3JldEtleTMyt=
JWT_EXPIRATION_HOURS=24

# --- SERVER & RUNTIME ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8181
ENVIRONMENT=production
RUST_LOG=management_system=info,tower_http=info,sqlx=warn
LOG_FORMAT=json

# --- CORS & ACCESS CONTROL ---
# Asal domain web yang diizinkan mengakses API (pisahkan dengan koma jika lebih dari satu)
CORS_ALLOWED_ORIGINS=https://erp.perusahaan.co.id

# Matikan registrasi publik dan rute dev/testing di lingkungan produksi
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_DEV_TEST_ROUTES=false

# --- FILE UPLOADS ---
UPLOAD_MAX_SIZE_MB=15

# --- EMAIL NOTIFICATIONS (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifikasi@perusahaan.co.id
SMTP_PASS=app-specific-password
SMTP_FROM="ERPQu Notifikasi <noreply@perusahaan.co.id>"

# --- WHATSAPP NOTIFICATION GATEWAY (INDONESIA) ---
# Provider: fonnte | wablas | ultramsg | generic_webhook
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=your_fonnte_or_wablas_token_here
WHATSAPP_SENDER_PHONE=081234567890
