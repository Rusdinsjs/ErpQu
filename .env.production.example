# ═══════════════════════════════════════════════════════════════
# ERPQu Production Environment Configuration
# ═══════════════════════════════════════════════════════════════
# SECURITY WARNING: 
#   - Never commit this file with real values to version control!
#   - All variables marked with (REQUIRED) MUST be set before deployment.
#   - Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════

ENVIRONMENT=production

# ─── Domain & TLS ───────────────────────────────────────────
# (REQUIRED) Your domain name for TLS certificate
NGINX_HOST=erp.yourdomain.com

# ─── Database Configuration ────────────────────────────────
# (REQUIRED) PostgreSQL superuser password — use 20+ random characters
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM_PASSWORD_20_CHARS

# (REQUIRED) Application database user (restricted privileges)
DB_APP_USER=erpqu_app
DB_APP_PASSWORD=CHANGE_ME_TO_ANOTHER_STRONG_PASSWORD

DB_NAME=management_system

# Internal Docker network URLs (do NOT change unless custom networking)
MIGRATION_DATABASE_URL=postgres://postgres:${DB_PASSWORD}@postgres:5432/${DB_NAME}?options=-c%20search_path=public,hr,crm,rental,inventory,commercial
DATABASE_URL=postgres://erpqu_app:${DB_APP_PASSWORD}@postgres:5432/${DB_NAME}?options=-c%20search_path=public,hr,crm,rental,inventory,commercial

# ─── Redis Cache ────────────────────────────────────────────
# (REQUIRED) Redis password — use 20+ random characters
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_REDIS_PASSWORD

# Internal Docker network URL (do NOT change)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ─── JWT Authentication ────────────────────────────────────
# (REQUIRED) JWT signing secret — MUST be at least 32 random characters
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_RANDOM_BASE64_STRING_AT_LEAST_48_CHARS

# Token expiry in hours (default: 24h, reduce for higher security)
JWT_EXPIRATION_HOURS=24

# ─── API Server ─────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8181

# ─── Security Policies ─────────────────────────────────────
# CORS: Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://erp.yourdomain.com

# Disable public self-registration in production
ALLOW_PUBLIC_REGISTRATION=false

# Disable development test routes
ALLOW_DEV_TEST_ROUTES=false

# Maximum upload file size (MB)
UPLOAD_MAX_SIZE_MB=10

# ─── SMTP Email (Optional but Recommended) ─────────────────
# Required for: password reset, notifications, report delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=noreply@yourdomain.com

# ─── Logging ────────────────────────────────────────────────
# Production: use json format for structured log aggregation
RUST_LOG=management_system=info,tower_http=info,sqlx=warn
LOG_FORMAT=json

# ─── Backup Configuration ──────────────────────────────────
# Number of days to retain daily backups (weekly=90d, monthly=365d)
BACKUP_RETENTION_DAYS=30

# ─── Docker Image Tag ──────────────────────────────────────
IMAGE_TAG=latest
